# AgriLedger AI — Environment Configuration
#
# Copy this file to .env in the project root and fill in real values.
# NEVER commit .env to version control.
# .env is already listed in .gitignore (verify before committing).
#
# Usage:
#   Local development : all variables are optional; sensible defaults apply.
#   Production        : AGRILEDGER_SECRET_KEY and MYSQL_PASSWORD are required.
#                       ProductionConfig.validate() will raise on startup if
#                       they are missing or insecure.

# --------------------------------------------------------------------
# Flask secret key
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# Minimum 32 characters. Must NOT be the development fallback in production.
# --------------------------------------------------------------------
AGRILEDGER_SECRET_KEY=change-this-to-a-strong-random-secret-before-deploying

# --------------------------------------------------------------------
# MySQL / TiDB connection
# Defaults shown here match the local development setup.
# For TiDB Cloud (Singapore region), set MYSQL_HOST to your cluster host,
# MYSQL_PORT=4000, and MYSQL_SSL_CA=backend/certs/isrgrootx1.pem
# --------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=agri_ledger
# Optional SSL CA certificate path for cloud databases (e.g. TiDB Cloud).
# Leave commented out or unset for local MySQL development.
# MYSQL_SSL_CA=backend/certs/isrgrootx1.pem

# --------------------------------------------------------------------
# Flask runtime & CORS
# Set to "production" when deploying. Never set DEBUG=1 in production.
# In production, specify comma-separated allowed origins.
# --------------------------------------------------------------------
FLASK_ENV=development
# FLASK_DEBUG=0
# CORS_ORIGINS=https://app.agriledger.com,https://admin.agriledger.com

# --------------------------------------------------------------------
# Notes for production deployment
# --------------------------------------------------------------------
# 1. Run behind HTTPS (nginx / reverse proxy).
# 2. SESSION_COOKIE_SECURE is set to True by ProductionConfig automatically.
# 3. Run with:  flask --app backend.app run  (after loading .env)
#    Or use gunicorn:  gunicorn "backend.app:create_app()"
# 4. Call ProductionConfig.validate() in your WSGI entry point.
